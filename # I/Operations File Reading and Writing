import java.io.*;

public class Main {
    public static void main(String[] args) throws Exception {

        FileOutputStream out = new FileOutputStream("data.txt");
        out.write("Student Name: Arun".getBytes());
        out.close();

        FileInputStream in = new FileInputStream("data.txt");
        int ch;

        System.out.println("Using FileInputStream:");
        while ((ch = in.read()) != -1) {
            System.out.print((char) ch);
        }
        in.close();

        FileWriter writer = new FileWriter("data2.txt");
        writer.write("Welcome to Java");
        writer.close();

        FileReader reader = new FileReader("data2.txt");

        System.out.println("\nUsing FileReader:");
        while ((ch = reader.read()) != -1) {
            System.out.print((char) ch);
        }
        reader.close();
    }
}
