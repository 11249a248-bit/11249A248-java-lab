import java.util.Scanner;

class ShopAnalysis {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        double[] sales = new double[12];

        System.out.println("Enter monthly sales:");

        for (int i = 0; i < 12; i++) {
            System.out.print("Month " + (i + 1) + ": ");
            sales[i] = sc.nextDouble();
        }

        double highest = sales[0];
        double lowest = sales[0];

        for (int i = 1; i < 12; i++) {
            if (sales[i] > highest)
                highest = sales[i];

            if (sales[i] < lowest)
                lowest = sales[i];
        }

        System.out.println("\nHighest Sale: " + highest);
        System.out.println("Lowest Sale: " + lowest);

        double[] reviews = new double[5];
        double total = 0;

        System.out.println("\nEnter 5 customer reviews:");

        for (int i = 0; i < 5; i++) {
            System.out.print("Review " + (i + 1) + ": ");
            reviews[i] = sc.nextDouble();
            total = total + reviews[i];
        }

        double average = total / 5;

        System.out.println("Average Customer Review: " + average);
    }
}
